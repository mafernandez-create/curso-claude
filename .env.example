# .env.example — variables para el envío del digest de novedades por correo.
#
# Copia este fichero a `.env` (en la raíz del repo) y rellena los valores.
# El `.env` NUNCA se sube a git (ya está en .gitignore).
#
# Los nombres coinciden con los del resto del ecosistema (p. ej. posicionamiento),
# para que puedas reutilizar la misma cuenta SMTP de agentes.

# --- Servidor SMTP de salida ---
# Para Gmail: host smtp.gmail.com, puerto 587, y una CONTRASEÑA DE APLICACIÓN
# (no la contraseña normal): https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=grupogpf.malaga@gmail.com
SMTP_PASSWORD=

# --- Remitente y destinatario del digest ---
# DIGEST_FROM es opcional; si se omite, se usa SMTP_USER.
DIGEST_FROM=grupogpf.malaga@gmail.com
DIGEST_TO=villabotijo@gmail.com
